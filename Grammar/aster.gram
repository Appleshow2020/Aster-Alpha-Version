# Aster 문법 (PEG 표기. CPython의 Grammar/python.gram과 같은 방식)
#
# 표기
#   'if'      하드 키워드: 식별자로 쓸 수 없다
#   "getter"  소프트 키워드: 지정된 위치에서만 키워드로 취급
#   NAME ...  Grammar/Tokens의 토큰
#   e*  e+  [e]   반복 / 옵션
#   a | b     순서가 있는 선택 (앞에서부터 시도, 실패하면 되돌아감)
#   !e        부정 선행 탐색 (e가 뒤따르지 않아야 성공, 입력을 소비하지 않음)
#   &{ ... }  파서가 구현하는 술어(predicate)
# 줄 맨 앞에서 시작하는 'name:' 이 규칙이다. 규칙 이름은 parser/parser.py의
# @rule 메서드 이름과 같고, 아래 키워드 목록도 parser.py와 같다.
# (둘 다 Tools/check_conformance.py가 검사한다.)
# [Q..], [D..], [N..] 는 Grammar/OPEN_QUESTIONS.md의 항목에서 온 규칙이다.
#
# 하드 키워드:
#   package import from as fn class extends implements interface new self
#   public protected private internal
#   if else while for break continue return throw try catch finally
#   typedef struct and or not is in true false sizeof
#   int float bool str null void
# 소프트 키워드: constructor getter setter property

# ===== 시작 규칙 (파서 API용. CPython의 eval 입력 규칙과 같은 역할) =====

file: [package_stmt] statement* ENDMARKER
eval_input: expression ENDMARKER
type_input: type ENDMARKER

package_stmt: 'package' dotted_name ';'
dotted_name: NAME ('.' NAME)*

# ===== 문장 =====

statement:
    | compound_stmt
    | simple_stmt

# 블록으로 끝나는 구문: 닫는 '}' 뒤에 ';'를 붙이지 않는다.
# (struct_def, typedef_struct는 C 문법에 따라 ';'로 끝난다.)
compound_stmt:
    | function_def
    | class_def
    | interface_def
    | struct_def
    | typedef_struct
    | if_stmt
    | while_stmt
    | for_stmt
    | try_stmt

# 일반 문장: 모두 ';'로 끝난다.
# var_decl이 assign_stmt, expr_stmt보다 먼저여야 한다.
# (Counter c = ...; 와 c.f(); 구분. 'Point * p;'는 C처럼 선언으로 읽는다.)
simple_stmt:
    | import_stmt
    | return_stmt
    | throw_stmt
    | break_stmt
    | continue_stmt
    | var_decl
    | assign_stmt
    | expr_stmt

block: '{' statement* '}'

import_stmt:
    | 'import' dotted_name '.' '*' ';'          # [D12a] import aster.lang.String.*;
    | 'import' dotted_name ';'
    | 'from' dotted_name 'import' '*' ';'       # [D12a] from aster.lang.String import *;
    | 'from' dotted_name 'import' NAME ';'

return_stmt: 'return' [expression] ';'
# [D4][D14][D14a]
#   throw "문자열"              -> Exception
#   throw "문자열" as ValueError -> ValueError("문자열")
#   throw ValueError            -> 메시지 없는 ValueError (이름이 예외 클래스일 때)
#   throw 예외값                -> 그 예외 (as는 쓸 수 없다. typecheck에서 검사)
throw_stmt: 'throw' expression ['as' NAME] ';'
break_stmt: 'break' ';'
continue_stmt: 'continue' ';'
expr_stmt: expression ';'

# ===== 선언과 대입 =====

var_decl: var_decl_core ';'

# [D3] 'Point p(10, 20);' 형태는 없다. 생성은 new를 쓴다.
var_decl_core:
    | type NAME '=' initializer        # int c = 3;  Point* p = new Point(1, 2);
    | type NAME                        # int x;  struct Point p5;

initializer:
    | brace_init                       # [Q2.1][Q2.2]
    | expression

# 위치 초기화와 지정 초기화는 섞어 쓰지 않는다.
brace_init:
    | '{' '}'                          # {}
    | '{' designated_init (',' designated_init)* '}'
    | '{' expression (',' expression)* '}'
designated_init: '.' NAME '=' expression

assign_stmt: assign_core ';'
# 좌변은 NAME, 속성 접근(a.b, p->b), 역참조(*p)만 허용한다.
# 파서가 &{ is_assignable }로 검사한다.
# [D6b] 'NAME = 람다식;' 에서 NAME이 아직 선언되지 않았다면 이것이 변수 선언이다.
# 이것은 타입 검사기가 결정하며, 파서는 일반 대입으로만 읽는다.
assign_core: assign_target assign_op expression
assign_target:
    | '*' assign_target                # [D2] *p = 5;
    | '**' assign_target               # **pp = 5;  (DOUBLESTAR를 '*' 두 개로)
    | postfix_expr
assign_op:
    | '=' | '+=' | '-=' | '*=' | '/=' | '//=' | '%=' | '**='    # [N4]

# ===== 타입 =====

# void는 type에 없다: 변수/필드/매개변수 타입으로 쓰는 것이 문법 단계에서 거부된다.
# nullable은 맨 끝에만 온다: int?  int*?  (int?* 는 불가)  [명세 변경: 원래 프롬프트는 금지]
# null?, null* 는 문법은 통과하고 typecheck에서 거부한다.
# [D6b] 함수 타입 표기는 없다.
type: type_base pointer_suffix* ['?']
type_base:
    | primitive_type
    | 'struct' NAME                    # [Q2.1] struct Point p;
    | NAME [type_args]                 # 클래스, 구조체 태그/별칭, 파이썬 예외 이름, 제네릭 Box<int>
primitive_type: 'int' | 'float' | 'bool' | 'str' | 'null'
# '**'는 포인터 두 단계로 읽는다 (int** pp).  [D2]
pointer_suffix: '*' | '**'
# '>>' 토큰이 없으므로 중첩(Box<Box<int>>)이 된다.
type_args: '<' type (',' type)* '>'
named_type: NAME [type_args]           # extends / implements 에서 사용

# 반환 타입은 생략할 수 없다.
return_type: 'void' | type

# ===== 함수 =====

# [D6a] 제네릭 함수. 호출 시 타입 인자는 추론한다 (f<int>(3) 형태는 없다).
# 파서의 is_declared_type_name 술어는 현재 함수/클래스의 type_params 이름도 타입 이름으로 취급한다.
function_def: 'fn' NAME [type_params] '(' [parameters] ')' '->' return_type block
type_params: '<' NAME (',' NAME)* '>'
parameters: parameter (',' parameter)*
parameter: type NAME

# ===== 클래스 =====

# [D16] 제네릭 클래스. T에 제약(extends)은 없다.
class_def:
    'class' NAME [type_params] ['extends' named_type]
    ['implements' named_type (',' named_type)*]
    '{' class_member* '}'

# 소프트 키워드 규칙을 먼저 시도한다.
class_member:
    | constructor_def
    | property_decl
    | getter_def
    | setter_def
    | method_def
    | field_decl

access_modifier: 'public' | 'protected' | 'private' | 'internal'

field_decl: [access_modifier] type NAME ['=' expression] ';'
method_def: [access_modifier] 'fn' NAME [type_params] '(' [parameters] ')' '->' return_type block

# 생성자는 반환 타입을 쓰지 않는다.
constructor_def: "constructor" '(' [parameters] ')' block

# [Q5] 줄바꿈은 공백이다. ';'가 선언의 끝이다.
property_decl: [access_modifier] '@' "property" type NAME ';'
getter_def: "getter" NAME block
# setter의 매개변수 이름은 value여야 한다 (파서가 &{ name == 'value' }로 검사).
setter_def: "setter" NAME '(' type NAME ')' block

# ===== 인터페이스 =====

# [D5] 클래스 메서드 시그니처에서 본문 block만 ';'로 바꾼 형태.
interface_def: 'interface' NAME '{' interface_method* '}'
interface_method:
    [access_modifier] 'fn' NAME '(' [parameters] ')' '->' return_type ';'

# ===== 구조체 =====

# 'struct' NAME 다음에 '{'가 없으면 struct_def가 실패하고
# var_decl(struct Point p;)로 되돌아간다.
struct_def: 'struct' NAME struct_body ';'                      # [Q2.1]
typedef_struct: 'typedef' 'struct' NAME struct_body NAME ';'

struct_body: '{' struct_member* '}'
struct_member:
    | struct_constructor
    | struct_field
struct_field: type NAME ';'

# [D3] 구조체 안의 생성자는 구조체 이름으로 쓴다 (constructor 키워드 없음).
# 이름은 구조체 태그 또는 별칭과 같아야 한다 (&{ 술어 }). 별칭은 닫는 '}' 뒤에 나오므로
# 파서가 파일을 먼저 훑어서 미리 안다.
# [D15] 초기화 리스트는 선택이다. ':'를 썼다면 member_init이 하나 이상 있어야 한다.
struct_constructor:
    NAME '(' [parameters] ')' [':' member_init (',' member_init)*] block
member_init: NAME '(' expression ')'

# ===== 제어문 =====

if_stmt: 'if' '(' expression ')' block ['else' else_body]
else_body:
    | block
    | if_stmt                                                  # [N3] else if

while_stmt: 'while' '(' expression ')' block

for_stmt:
    | range_for_stmt
    | c_for_stmt

# [Q6] for (int i; i = 1..6..2): ';' 앞은 변수 선언, 뒤는 범위 대입.
# 두 NAME은 같아야 한다. AST(ForRange)에는 이름이 하나만 남으므로 파서가 검사한다.
# 범위 연산자 '..'는 값이 아니라 이 구문 안에서만 쓸 수 있다.
range_for_stmt: 'for' '(' type NAME ';' NAME '=' range_expr ')' block
range_expr: arith '..' arith ['..' arith]

c_for_stmt: 'for' '(' for_init ';' expression ';' for_step ')' block
for_init: var_decl_core | assign_core
for_step: assign_core

try_stmt:
    | 'try' block catch_clause+ ['finally' block]
    | 'try' block 'finally' block
# [D4][D14] 타입 이름은 파이썬 builtins의 예외 이름 (Exception, ValueError ...).
# 변수 e는 포인터가 아니라 값이다 (typecheck에서 'Exception*' 등은 거부).
catch_clause: 'catch' '(' type NAME ')' block

# ===== 식 (우선순위: 위가 낮고 아래가 높다. [N11] 유지) =====

expression:
    | lambda_expr
    | pipe_expr

# [D1][D6] 반환 타입 필수.
#   단일 매개변수는 타입 생략 가능:   x => x*x -> int
#   다중 매개변수는 타입 필수:        (int a, int b) => a+b -> int
#   매개변수 없음은 '()' 가 필요하다:  () => 식 -> T     ('()'와 '=>'가 있어야 람다)
#
# [D7] lambda_body는 파서 플래그 no_arrow=True 로 읽는다.
#   본문의 최상위(괄호 밖)에서 만난 '->'는 항상 반환 타입 화살표다.
#   포인터 멤버 접근은 괄호로 감싸야 한다:  x => (p->v) -> int
#   no_arrow는 '(' ... ')' 안(괄호식, 호출 인자, 캐스트, sizeof)에서 해제된다.
#   본문 최상위에는 lambda_expr를 쓸 수 없다 (괄호 안에서는 가능).
#   !'->' 때문에 x => p->v -> int 는 SyntaxError가 된다
#   (본문 p, 반환 타입 v, 그 뒤에 또 '->'). 파서는 이 경우
#   "람다 본문의 포인터 접근은 괄호로 감싸야 합니다" 메시지를 낸다.
# '=>' 는 람다에만 쓰이므로, '=>'를 읽은 뒤의 실패는 되돌아가지 않고 바로 오류다
# (본문 없음, '-> 타입' 없음 등. 각각 전용 메시지를 낸다).
lambda_expr:
    | NAME '=>' lambda_body '->' return_type !'->'
    | '(' [parameters] ')' '=>' lambda_body '->' return_type !'->'
lambda_body: pipe_expr

pipe_expr: coalesce_expr ('|>' coalesce_expr)*
coalesce_expr: or_expr ['??' coalesce_expr]
or_expr: and_expr ('or' and_expr)*
and_expr: not_expr ('and' not_expr)*
not_expr:
    | 'not' not_expr
    | comparison

# 비교는 연쇄하지 않는다 (a < b < c 불가).
comparison:
    | arith 'is' type
    | arith 'in' arith
    | arith comp_op arith
    | arith
comp_op: '==' | '!=' | '<=' | '>=' | '<' | '>'

arith: term (('+' | '-') term)*
term: unary (('*' | '/' | '//' | '%') unary)*

unary:
    | ('+' | '-') unary
    | '&' unary                        # [D2] 주소
    | '*' unary                        # [D2] 역참조
    | '**' unary                       # [D2][D8] 역참조 두 번 (a**p는 거듭제곱, a * *p가 역참조)
    | cast
    | power

# C 스타일 캐스트 (타입)값.
# 이름 타입은 선언된 타입 이름일 때만 캐스트다. (x) + 1 이 캐스트로 오해되지 않도록
# 파서가 클래스/구조체/별칭 이름 집합을 유지한다 (C의 typedef 문제와 같은 해법).
# 이 집합은 파일을 먼저 훑어서 모은다 (선언 순서와 무관하다).
cast: '(' cast_type ')' unary
cast_type:
    | primitive_type pointer_suffix* ['?']
    | 'struct' NAME pointer_suffix* ['?']
    | NAME &{ is_declared_type_name } [type_args] pointer_suffix* ['?']

power: postfix_expr ['**' unary]                               # 오른쪽 결합

# '->'(포인터 멤버 접근)는 no_arrow 플래그가 꺼져 있을 때만 후위 연산자다.
postfix_expr: primary ('.' NAME | '->' NAME | '(' [arguments] ')')*

primary:
    | sizeof_expr
    | 'new' NAME [type_args] '(' [arguments] ')'               # [D11] 주소를 반환
    | 'self'                                                   # [D11c] 현재 인스턴스의 포인터
    | 'true' | 'false'                                         # [N1]
    | 'null'
    | FLOAT
    | INT
    | STRING
    | NAME
    | '(' expression ')'

# [D9] sizeof(struct Point), sizeof(int), sizeof(Point*)
sizeof_expr: 'sizeof' '(' sized_type ')'
sized_type:
    | primitive_type pointer_suffix*
    | 'struct' NAME pointer_suffix*
    | NAME &{ is_declared_type_name } [type_args] pointer_suffix*

arguments: expression (',' expression)*