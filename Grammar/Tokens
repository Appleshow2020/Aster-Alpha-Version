# Aster 토큰 목록 (CPython의 Grammar/Tokens 형식)
# 이름만 있는 줄은 문자열이 정해지지 않은 토큰이고,
# 이름 뒤에 '문자열'이 있으면 그 문자열 하나로만 이루어진 토큰(exact token)이다.
# 키워드는 여기 없다. 키워드는 NAME 토큰이며 aster.gram이 문자열로 구분한다.
# Aster는 중괄호 블록 언어라 NEWLINE/INDENT/DEDENT 토큰이 없다.

ENDMARKER
NAME
INT
FLOAT
STRING

# 구분자
LPAR                    '('
RPAR                    ')'
LBRACE                  '{'
RBRACE                  '}'
LSQB                    '['
RSQB                    ']'
SEMI                    ';'
COMMA                   ','
DOT                     '.'
COLON                   ':'
AT                      '@'

# 화살표
ARROW                   '->'      # 반환 타입, 포인터 멤버 접근 (두 가지 뜻)
FATARROW                '=>'      # 람다

# 산술
PLUSPLUS                '++'
MINUSMINUS              '--'
PLUS                    '+'
MINUS                   '-'
STAR                    '*'       # 곱셈, 포인터 타입, 역참조
SLASH                   '/'
DOUBLESLASH             '//'
PERCENT                 '%'
DOUBLESTAR              '**'      # 거듭제곱 (타입/단항 위치에서는 '*' 두 개)

# 비교
EQEQUAL                 '=='
NOTEQUAL                '!='
LESS                    '<'
GREATER                 '>'
LESSEQUAL               '<='
GREATEREQUAL            '>='

# 대입
EQUAL                   '='
PLUSEQUAL               '+='
MINEQUAL                '-='
STAREQUAL               '*='
SLASHEQUAL              '/='
DOUBLESLASHEQUAL        '//='
PERCENTEQUAL            '%='
DOUBLESTAREQUAL         '**='

# 그 밖의 연산자
DOTDOT                  '..'
PIPE                    '|>'
VBAR                    '|'       # 합집합 타입 (int | str)
DOUBLEQUESTION          '??'
QUESTIONDOT             '?.'      # null 안전 멤버 접근
QUESTION                '?'       # nullable 타입 접미사 (int?)
AMPER                   '&'       # 주소 연산자 (단항만. 이항 비트 연산 없음)

# ---------------------------------------------------------------
# 어휘 규칙 (tokenizer.py가 따른다)
#
# 1. 연산자는 가장 긴 것부터 일치시킨다 (**=가 **보다, **가 *보다, ..가 .보다 먼저).
# 2. 주석: '#' 한 줄, '/* ... */' 여러 줄(중첩 불가, 닫히지 않으면 오류).
#    '//'는 주석이 아니라 연산자다. '/*'는 항상 주석의 시작이다.
# 3. NAME은 파이썬 식별자 규칙(str.isidentifier)을 따른다.
# 4. INT는 십진 숫자열이다. 값의 범위는 파이썬 int(무제한)를 따른다.
#    FLOAT은 "숫자 '.' 숫자"만 해당한다. 값의 범위는 파이썬 float를 따른다.
#    점 뒤에 숫자가 없으면 FLOAT이 아니다.
#    그래서 1..6..2 는 INT DOTDOT INT DOTDOT INT 로 나뉜다.
#    숫자 바로 뒤에 식별자 문자(영문, '_' 등)가 붙으면(3abc, 1_000) 어휘 오류다.
# 5. STRING은 큰따옴표 "..." 또는 작은따옴표 '...' 이다.
#    이스케이프는 파이썬과 같다:
#      \n \t \r \a \b \f \v \\ \' \"  \ooo(8진 1~3자리, \0 포함)
#      \xhh  \uXXXX  \UXXXXXXXX  \N{이름}
#    작은따옴표 문자열은 char가 아니라 str이다.
#    접두사(r, f, b 등)와 삼중 따옴표는 없다.
#    문자열 안에 실제 줄바꿈이 있거나 닫히지 않으면 어휘 오류다.
#    알 수 없는 이스케이프(\q)와 '\' 바로 뒤의 줄바꿈도 어휘 오류다.
# 6. 아래는 어휘 오류다.
#      &&   ||   !
#    ('!='의 일부로만 존재할 수 있다. '|'는 합집합 타입 표기에만 쓰고
#     '||'는 계속 금지한다.)
#    '&&', '||', '!'는 논리 연산자를 and/or/not만 쓰기 위해 계속 금지한다.
#    '|'는 타입 위치의 합집합(int | str)에만 쓰고, 식 위치에서는 파서가 거부한다.
#    '&'와 '?'는 합법 토큰이다 (포인터, nullable).
#    '[', ']'는 리스트 리터럴·서브스크립트·슬라이스에 쓴다.
#    '{', '}'는 블록과 딕셔너리/세트 리터럴에 함께 쓴다 (파서가 문맥으로 구분).
#    'int??' 는 DOUBLEQUESTION으로 읽히고 parser가 SyntaxError로 거부한다.
# 7. '>>' 토큰이 없으므로 Box<Box<int>> 의 '>' 두 개는 각각 토큰이다.
#    단, 'Box<int>=' 처럼 붙여 쓰면 '>=' 로 읽히므로 '>' 와 '=' 사이에 공백이 필요하다.
# 8. 공백은 ' ', '\t', '\f'와 줄바꿈이다. 줄바꿈은 \n, \r\n, \r 모두 \n으로 본다.
#    파일 맨 앞의 BOM(U+FEFF)은 무시한다.
# 9. 위치: 줄은 1부터, 열은 0부터 세며 문자 단위다.