fn add(int left, int right) -> int {
    return left + right;
}

fn greet(str name) -> void {
    System.stdout.println("Hello, " + name);
}
#---
fn double(int value) -> int { return value * 2; }
int r = 10 |> double;
#---
# 제네릭 함수 [D6a]. 호출 때 타입은 추론한다.
fn id<T>(T v) -> T { return v; }
fn pair<A, B>(A a, B b) -> int { return 0; }
int y = id(3);
#---
# 중첩 함수와 값 없는 return
fn outer() -> void {
    fn inner(int a) -> int { return a; }
    return;
}
#---
# 제네릭 함수 안에서는 T가 선언된 타입 이름이므로 캐스트가 된다
fn conv<T>(int x) -> T { return (T) x; }
#---
# 클래스 값을 매개변수와 반환 타입으로 쓴다 [D11d]
fn reset(Counter target) -> Counter { return target; }
Counter c;
#---
# 선언된 타입 이름의 캐스트: 선언이 뒤에 있어도 된다
fn f(Late* q) -> int* { return (int*) q; }
class Late {}