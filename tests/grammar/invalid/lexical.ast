# '&&'는 쓰지 않는다 (and)
a = b && c;
#---
# '||'는 쓰지 않는다 (or)
a = b || c;
#---
# '!'는 쓰지 않는다 (not)
a = !b;
#---
# '|'는 단독으로 쓸 수 없다
a = b | c;
#---
# 배열은 아직 없다
int[] values;
#---
x = a[0];
#---
# 숫자에는 밑줄과 지수가 없다
int x = 1_000;
#---
int x = 3abc;
#---
# 닫히지 않은 문자열
str s = "unterminated;
#---
# 알 수 없는 이스케이프
str s = "bad \q escape";
#---
