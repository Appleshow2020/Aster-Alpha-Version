# 반환 타입은 생략할 수 없다
fn f() { }
#---
fn f() -> { }
#---
fn f(void a) -> int { return 1; }
#---
fn f(int a,) -> int { return a; }
#---
# 정의의 닫는 중괄호 뒤에는 ';'를 붙이지 않는다
fn f() -> void { };
#---
fn f<>() -> void { }
#---
fn f<T,>() -> void { }
#---
# 함수 타입 표기는 없다 [D6b]
fn(int a) -> int f;
#---
# 제네릭 함수는 f(3)처럼 부르고 f<int>(3)은 없다 [D16]
f<int>(3);
#---
# 람다에는 반환 타입이 필요하다
x => x * x;
#---
# 람다 본문의 포인터 접근은 괄호가 필요하다 [D7]
x => p->v -> int;
#---
# 여러 매개변수나 괄호 안의 매개변수는 타입이 있어야 한다
(int a, b) => a -> int;
#---
(x) => x -> int;
#---
x, y => x -> int;
#---
fn f() -> int {
    return 1;