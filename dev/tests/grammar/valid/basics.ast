# 변수 선언, 복합 대입, 호출, 출력
int count = 3;
count += 1;
count -= 1;
count *= 2;
count /= 2;
count //= 2;
count %= 2;
count **= 2;
System.stdout.println("count", count);
#---
# 기본 타입과 리터럴 (문자열은 큰따옴표와 작은따옴표 모두)
int a = 1;
float b = 2.5;
bool c = true;
bool d = false;
str s = "hi\n";
str q = 'say "x"';
#---
# nullable, 선언만 한 변수
int? maybe = null;
int? other = 3;
int total = maybe ?? 0;
int x;
str name;
#---
# 타입 표기
int* p;
int** pp;
int*? np;
Counter* c;
Counter? d;
Box<int> b;
Box<Box<int>>* nested;
Pair<int, str> pair;
struct Point sp;
struct Point* spp;
ValueError err;
#---
# C 스타일 캐스트 (타입)값
int n = (int) 3.8;
str label = (str) n;
float f = (float) n / 2;
#---
# 패키지 (파일 맨 앞에 한 번)
package aster.time;
#---
# import 네 가지
import aster.time.LocalTime;
from aster.time import LocalTime;
import aster.lang.String.*;
from aster.lang.String import *;
#---
# 포인터: 주소, 역참조, 대입
int v = 3;
int* p = &v;
*p = 5;
int** pp = &p;
**pp = 7;
p->x = 1;
self->value += 1;
a.b.c = 2;
#---
# 람다를 처음 대입할 때는 타입 없이 선언한다 [D6b]
add = (int a, int b) => a + b -> int;
square = x => x * x -> int;
hello = () => System.stdout.println("hi") -> void;
r = apply(x => x * x -> int, 3);