typedef struct Point {
    int x;
    int y;
} Point;
#---
struct Point { int x; int y; };
struct Point p5;
#---
# 초기화: 위치, 지정, 전체 [Q2.1][Q2.2]
struct Point { int x; int y; };
struct Point p1 = {10, 20};
struct Point p2 = { .y = 20, .x = 10 };
struct Point p3 = { 0 };
struct Point p4 = {};
#---
# 구조체 생성자: 구조체 이름으로 쓴다 [D3]. 일반 코드에서는 new를 쓴다.
typedef struct Point {
    int x;
    int y;
    Point(int a, int b): x(a), y(b) {}
} Point;
Point* p6 = new Point(10, 20);
#---
# 초기화 리스트는 선택이다 [D15]
typedef struct Pair { int a; int b; Pair() { } } Pair;
#---
# 태그와 별칭 중 어느 쪽 이름으로도 생성자를 쓸 수 있다
typedef struct _Node { int v; Node(int x) : v(x) {} _Node() {} } Node;
#---
# memset은 C와 같다 (aster.lang.String은 임시 구조)
import aster.lang.String.*;
struct Point { int x; int y; };
struct Point p5;
memset(&p5, 0, sizeof(struct Point));