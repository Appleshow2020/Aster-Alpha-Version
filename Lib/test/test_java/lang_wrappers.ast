import System.stdout.*;
import aster.lang.Integer;
import aster.lang.Long;
import aster.lang.Math;
import aster.util.Arrays;
import aster.util.Objects;

println(Integer.MAX_VALUE);
println(Integer.MIN_VALUE);
println(Integer.parseInt("123"));
println(Integer.parseInt("-456"));
println(Integer.parseInt("ff", 16));
println(Integer.parseInt("1010", 2));
println(Integer.toString(255, 16));
println(Integer.toString(-255, 16));
println(Integer.toString(-2147483648, 2));
println(Integer.toHexString(-1));
println(Integer.toOctalString(8));
println(Integer.toBinaryString(10));
println(Integer.compare(3, 9));
println(Integer.compareUnsigned(-1, 1));
println(Integer.signum(-5));
println(Integer.max(3, 9));
println(Integer.bitCount(-1));
println(Integer.highestOneBit(100));
println(Integer.lowestOneBit(12));
println(Integer.highestOneBit(-1));
println(Integer.highestOneBit(-2147483648));
println(Integer.lowestOneBit(-2147483648));

println(Long.parseLong("9223372036854775807"));
println(Long.toString(-255, 16));
println(Long.toString(-9223372036854775807 - 1, 16));
println(Long.parseLong("ff", 16));
println(Long.toHexString(-1));
println(Long.toHexString(-9223372036854775807 - 1));
println(Long.toBinaryString(10));
println(Long.compareUnsigned(-1, 1));
println(Long.bitCount(-1));

println(Math.abs(-7));
println(Math.abs(-2.5));
println(Math.max(3, 9));
println(Math.min(2.5, 1.5));
println(Math.floorDiv(7, 2));
println(Math.floorDiv(-7, 2));
println(Math.floorMod(-7, 2));
println(Math.sqrt(144.0));
println(Math.pow(2.0, 10.0));
println(Math.round(2.5));
println(Math.round(-2.5));

println(Arrays.toString([3, 1, 2]));
println(Arrays.toString(["a", "b"]));
println(Arrays.deepToString([[1, 2], [3]]));
println(Objects.equals(null, null));
println(Objects.equals("a", "a"));
println(Objects.isNull(null));
println(Objects.toString(null));
