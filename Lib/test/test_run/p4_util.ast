println("== Optional ==");
Optional<int> a = Optional.of(5);
Optional<int> b = Optional.empty();
println(a.isPresent());
println(b.isEmpty());
println(a.get());
println(b.orElse(9));
println(a.orElse(9));
println(a.orElseGet(() -> int => 42));
println(b.orElseGet(() -> int => 42));
println(a.map((int x) -> int => x * 2));
println(a.filter((int x) -> bool => x > 3));
println(a.filter((int x) -> bool => x > 8));
println(a.toString());
println(b.toString());
a.ifPresent((int x) -> void => println("got " + str(x)));
b.ifPresent((int x) -> void => println("never"));
b.ifPresentOrElse((int x) -> void => println("x"), () -> void => println("none"));
println(a.ofNullable(7).get());
println(Optional.ofNullable(null).isEmpty());
try { b.get(); } catch (Exception e) { println(e.name); }
println(OptionalInt.of(5).getAsInt());
println(OptionalInt.empty().orElse(-1));
println(OptionalInt.empty().isEmpty());
println(OptionalLong.of(9000000000).getAsLong());
println(OptionalDouble.of(2.5).getAsDouble());
println(OptionalDouble.empty().toString());

