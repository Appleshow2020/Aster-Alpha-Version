println("== UUID ==");
UUID u = UUID.randomUUID();
str s = u.toString();
println(s.length());
println(s.charAt(8) == "-");
println(s.charAt(13) == "-");
println(s.charAt(18) == "-");
println(s.charAt(23) == "-");
println(s.charAt(14) == "4");
str variant = s.charAt(19);
println(variant == "8" or variant == "9" or variant == "a" or variant == "b");
println(u.equals(UUID.fromString(s)));
println(UUID.fromString("01234567-89ab-4def-0123-456789abcdef").toString());
println(UUID.fromString("01234567-89ab-4def-0123-456789abcdef").getMostSignificantBits());
println(UUID.fromString("01234567-89ab-4def-0123-456789abcdef").getLeastSignificantBits());
println(u.compareTo(u));
println(UUID.fromString("00000000-0000-0000-0000-000000000001").compareTo(UUID.fromString("00000000-0000-0000-0000-000000000002")));

