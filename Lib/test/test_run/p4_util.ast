println("== BitSet ==");
BitSet bs = new BitSet();
bs.set(1);
bs.set(3);
bs.set(5, true);
println(bs.get(3));
println(bs.get(2));
println(bs.cardinality());
println(bs.length());
println(bs.nextSetBit(2));
println(bs.nextSetBit(9));
println(bs.toString());
bs.flip(3);
println(bs.get(3));
bs.clear(1);
println(bs.toString());
BitSet other = new BitSet();
other.set(2);
other.set(5);
bs.orWith(other);
println(bs.toString());
bs.andWith(other);
println(bs.toString());
bs.xorWith(other);
println(bs.toString());
bs.orWith(other);
bs.andNotWith(other);
println(bs.toString());
println(bs.isEmpty());

