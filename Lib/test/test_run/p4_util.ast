class Descending implements Comparator {
    public fn compare(any a, any b) -> int {
        int x = (int)a;
        int y = (int)b;
        return y - x;
    }
}

class ByLength implements Comparator {
    public fn compare(any a, any b) -> int {
        str x = (str)a;
        str y = (str)b;
        return x.length() - y.length();
    }
}

class Box implements Iterable {
    list<int> data;

    constructor(list<int> d) {
        self->data = d;
    }

    public fn iterator() -> Iterator {
        return new ListIteratorImpl<int>(self->data);
    }
}

