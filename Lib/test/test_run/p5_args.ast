import System.stdout.*;

fn myuser(str name, int age = 20, str role = "user") -> void {
    println(f"{name}, {age}, {role}");
}

fn add(int a, int b = 10, int c = 100) -> int {
    return a + b + c;
}

fn printinfo<T>(vararg T args, varkwarg T kwarg) -> void {
    println("args:", args);
    println("kwargs:", kwarg);
}

class Greeter {
    public fn greet(str name, str prefix = "Hello") -> void {
        println(f"{prefix}, {name}!");
    }
}

myuser("Bom");
myuser("Kim", 30);
myuser(role = "admin", name = "Asp");
myuser("Lee", role = "guest");
println(add(1));
println(add(1, c = 5));
println(add(b = 2, a = 3));
printinfo(1, 2, 3);
printinfo("a", "b", x = 1, y = 2);
Greeter g = new Greeter();
g.greet("Aster");
g.greet(prefix = "Hi", name = "Bob");
