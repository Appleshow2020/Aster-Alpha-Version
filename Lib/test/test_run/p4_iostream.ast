import aster.util.function.Consumer;
import aster.util.function.BiConsumer;
import aster.util.function.Supplier;
import aster.util.function.Predicate;
import aster.util.function.BiPredicate;
import aster.util.function.UnaryOperator;
import aster.util.function.BinaryOperator;
import aster.util.function.IntFunction;
import aster.util.function.IntPredicate;
import aster.util.function.IntConsumer;
import aster.util.function.IntSupplier;
import aster.util.function.IntUnaryOperator;
import aster.util.function.IntBinaryOperator;
import aster.util.function.BooleanSupplier;
import aster.util.function.DoubleSupplier;
import aster.util.function.DoublePredicate;
