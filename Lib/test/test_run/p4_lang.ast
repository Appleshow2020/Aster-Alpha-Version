/* ---------- custom interfaces ---------- */
class Version implements Comparable, Cloneable {
    private int major;
    private int minor;

    constructor(int a, int b) {
        self->major = a;
        self->minor = b;
    }

    public fn compareTo(any other) -> int {
        Version o = (Version) other;
        if (self->major < o->major) { return -1; }
        if (self->major > o->major) { return 1; }
        if (self->minor < o->minor) { return -1; }
        if (self->minor > o->minor) { return 1; }
        return 0;
    }

    public fn cloneValue() -> Version {
        return new Version(self->major, self->minor);
    }

    public fn __str__() -> str {
        return str(self->major) + "." + str(self->minor);
    }
}

class Text implements CharSequence {
    private str data;

    constructor(str d) {
        self->data = d;
    }

    public fn length() -> int {
        return self->data.length();
    }

    public fn charAt(int index) -> str {
        return self->data.charAt(index);
    }

    public fn substring(int start) -> str {
        return self->data.substring(start);
    }

    public fn substring(int start, int end) -> str {
        return self->data.substring(start, end);
    }

    public fn toString() -> str {
        return self->data;
    }

    public fn __str__() -> str {
        return self->data;
    }
}

class Task implements Runnable, AutoCloseable {
    public int runs;
    public bool closed;

    constructor() {
        self->runs = 0;
        self->closed = false;
    }

    public fn run() -> void {
        self->runs = self->runs + 1;
    }

    public fn close() -> void {
        self->closed = true;
    }
}

println("== interfaces ==");
Version v1 = new Version(1, 2);
Version v2 = new Version(2, 0);
println(v1->compareTo(v2));
println(v2->compareTo(v1));
println(v1->compareTo(v1->cloneValue()));
any cmp = v2;
println(cmp->compareTo(v1));
any cl = v1;
println(cl != null);
println(v1);

Text text = new Text("Aster");
println(text->length());
println(text->charAt(1));
println(text->substring(1, 3));
println(text->toString());
any seq = text;
println(seq->length());
println(seq->charAt(0));
println(seq->substring(1));
println(seq->toString());

Task task = new Task();
println(task->runs);
any runner = task;
runner->run();
runner->run();
println(task->runs);
any resource = task;
println(task->closed);
resource->close();
println(task->closed);

