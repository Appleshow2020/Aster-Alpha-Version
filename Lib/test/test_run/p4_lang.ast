/* ---------- validation errors ---------- */
println("== errors ==");
try {
    Integer.parseInt("42x");
} catch (ValueError e) {
    println("parse: " + e.name);
}
try {
    Integer.parseInt("7", 99);
} catch (ValueError e) {
    println("radix: " + e.name);
}
try {
    Character bad = new Character("");
} catch (ValueError e) {
    println("char: " + e.name);
}
try {
    Math.addExact(9223372036854775807, 1);
} catch (OverflowError e) {
    println("overflow: " + e.name);
}
println(Double.isNaN(Double.parseDouble("NaN")));
println(Float.isInfinite(Float.parseFloat("-Infinity")));
println(Integer.parseInt("2147483647"));
println(Integer.parseInt("-2147483648"));
println(Long.parseLong("-9223372036854775808"));
try { Integer.parseInt("2147483648"); } catch (ValueError e) { println("int-range: " + e.name); }
try { Long.parseLong("9223372036854775808"); } catch (ValueError e) { println("long-range: " + e.name); }
try { Long.parseLong("ffffffffffffffff", 16); } catch (ValueError e) { println("long-hex-range: " + e.name); }
