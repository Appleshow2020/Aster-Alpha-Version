import System.stdout.*;

fn myuser(str name, int age = 20, str role = "user") -> void {
    println(name, age, role);
}

fn add2(int a, int b) -> int {
    return a + b;
}

fn baddef(int x = "s") -> int {
    return x;
}

myuser();
