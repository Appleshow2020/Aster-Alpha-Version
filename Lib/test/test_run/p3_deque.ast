import System.stdout.*;
import aster.util.Deque;

Deque<int>* d = new Deque<int>();
d.addLast(2);
d.addLast(3);
d.addFirst(1);
d.addFirst(0);
println(d.size());
println(d);
println(d.removeFirst());
println(d.removeLast());
println(d.peekFirst());
println(d.peekLast());
println(d.pollFirst());
println(d.pollLast());
println(d.size());
d.push(40);
d.push(30);
d.add(50);
d.add(60);
println(d.toList());
println(d.get(0));
println(d.get(3));
d.set(1, 35);
println(d.toList());
println(d.contains(50));
println(d.contains(99));
println(len(d));
println(d.isEmpty());
d.clear();
println(d.isEmpty());
println(d.pollFirst());
