import System.stdout.*;
import aster.lang.String.*;

println("{} + {} = {}".format(1, 2, 3));
println("{1}-{0}".format("a", "b"));
println("{{literal}} {}".format(42));
println("[{:>8}]".format("hi"));
println("[{:<8}]".format("hi"));
println("[{:^8}]".format("hi"));
println("[{:08.3f}]".format(3.14159));
println("[{:+d}] [{: d}]".format(7, 7));
println("[{:.2s}]".format("abcdef"));
println("[{:x}] [{:X}] [{:o}] [{:b}]".format(255, 255, 8, 5));
println("[{:>10.2%}]".format(0.1234));
println("{}".format(true));
println("{}".format(1.5));
println("İSTANBUL".lower());
println("istanbul".upper());
println("ǆungla".upper());
println("ΑΒΓ-αβγ".lower());
println("ПРИВЕТ".lower(), "привет".upper());
println("ᲐᲑᲒ".lower(), "აბგ".upper());
println("ＡＢＣ".lower(), "ａｂｃ".upper());

println("value = {} ({})".format(10, "ten"));
println("[{:>6}] [{:*^6}]".format("ab", "cd"));
println("{:d}".format(-42), "{:x}".format(-255));

StringBuilder* sb = new StringBuilder();
sb.append("Hello").append(", ").appendLine("world").append("x");
println(sb.toString());
println(sb.length());
println(sb.isEmpty());
sb.reverse();
println(sb.toString());
sb.clear();
println(sb.isEmpty());
println(repeat("ab", 3));
println(padStart("7", 3, "0"));
println(padEnd("hi", 5, "."));
println(capitalize("aster"));
println(isBlank("  \t "));
println(lines("a\nb\nc"));
println(collapseSpaces("  a   b  c "));

StringBuilder* loop = new StringBuilder();
int i = 1;
while (i <= 5) {
    loop.append(f"#{i}");
    if (i < 5) { loop.appendChar(","); }
    i = i + 1;
}
println(loop.toString());
