import System.stdout.*;

enum Color {
    Red, Green, Blue;

    public fn isWarm() -> bool {
        return self == Color.Red;
    }

    public fn label() -> str {
        return self.name;
    }
}

enum Shape {
    Circle(float r), Rect(float w, float h), Empty;

    public fn area() -> float {
        switch (self) {
            case Shape.Circle(r) { return 3.14159 * r * r; }
            case Shape.Rect(w, h) { return w * h; }
            case Shape.Empty { return 0.0; }
        }
    }
}

Color c = Color.Red;
println(c.isWarm(), Color.Blue.isWarm());
println(c.label(), Color.Blue.label());
println(Color.Red.ordinal, Color.Red.name);
Shape s = Shape.Rect(2.0, 3.0);
println(s.area());
println(Shape.Circle(1.0).area());
