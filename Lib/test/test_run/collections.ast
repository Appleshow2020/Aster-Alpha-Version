import System.stdout.*;
a = [1, 2, 3];
println(a, len(a), a[0], a[-1]);
println(a[1:3], a[::-1], a + [4], a * 2);

t = (1, 2);
println(t, len(t), t[0], t[1:], t + (3,), t * 2);

d = {"a": 1, "b": 2};
println(d, len(d), d["a"], d.get("z"), d.keys(), d.values(), d.items());

s = {3, 1, 2, 2};
println(s, len(s), 1 in s, 4 in s);

f = frozenset([1, 2]);
println(f, len(f), f == {1, 2}, {1, 2} == f);

println([], (), {}, set(), frozenset());
println("abc" in "abcdef", "a" in ["a", "b"], "a" in {"a": 1});
println([1, 2] == [1, 2], (1, 2) == (1, 2), [1, 2] < [1, 3],
        (1, 2) < (1, 2, 0), {1, 2} < {1, 2, 3}, {1, 3} < {1, 2});
println(not [], not [0], not {}, not set());
println(list((1, 2)), tuple([1, 2]), dict([["a", 1]]),
        set([1, 2, 2]), frozenset([1, 1]));
