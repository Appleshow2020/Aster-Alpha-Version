import System.stdout.*;
fn area(int w, int h) -> int { return w * h; }
fn area(int side) -> int { return side * side; }
fn area(float r) -> float { return 3.14 * r * r; }

class Printer {
    public fn show(int x) -> void { println("int " + str(x)); }
    public fn show(str s) -> void { println("str " + s); }
}

fn main() -> void {
    println(area(3));
    println(area(2, 5));
    println(area(2.0));
    Printer* p = new Printer();
    p->show(7);
    p->show("hi");
}

main();
