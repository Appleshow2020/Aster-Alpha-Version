class Counter {
    private int value = 0;

    public fn increment() -> void {
        self->value += 1;
    }

    public fn getValue() -> int {
        return self->value;
    }
}

Counter* counter = new Counter();
counter->increment();
#---
class Person {
    private str name;

    constructor(str name) {
        self->name = name;
    }

    public fn getName() -> str {
        return self->name;
    }
}
#---
# 접근 제한자 (생략하면 private)
class A {
    public int a;
    protected int b;
    private int c;
    internal int d;
    int e;
    int f = 3;
}
#---
class Dog extends Animal implements Pet, Walker {}
#---
interface MyInterface {}
interface Shape {
    fn area() -> float;
    public fn name() -> str;
}
#---
# 프로퍼티: 선언과 접근자를 분리한다
class Person {
    private str _name;

    public @property
    str name;

    getter name {
        return self->_name;
    }

    setter name(str value) {
        self->_name = value;
    }
}
