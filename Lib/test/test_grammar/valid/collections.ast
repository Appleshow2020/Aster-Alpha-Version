# 리스트 리터럴 (빈 리스트, 중첩, 후행 쉼표)
[1, 2, 3];
[];
[[1], [2, 3]];
[1, 2, 3,];
#---
# 튜플 리터럴 (빈 튜플, 원소 하나, 후행 쉼표)
();
(1,);
(1, 2);
(1, 2,);
#---
# 딕셔너리 리터럴 (빈 딕셔너리는 {})
{};
{"a": 1};
{"a": 1, "b": 2,};
{(1, 2): "x"};
#---
# 세트 리터럴 (중복은 문법상 그대로 둔다)
{1};
{1, 2, 3};
{1, 2, 2};
#---
# 서브스크립트와 슬라이스
a = [1, 2, 3];
a[0];
a[-1];
a[1:2];
a[:2];
a[1:];
a[::2];
a[1:3:1];
#---
# 서브스크립트 대입과 복합 대입
d = {"a": 1};
d["a"] = 2;
d["a"] += 1;
#---
# 멤버십 (not in 포함)
s = {1, 2};
1 in s;
1 not in s;
x is not int;
#---
# 컬렉션 생성 내장 호출
set();
frozenset({1, 2});
list((1, 2));
tuple([1, 2]);
dict({"a": 1});
