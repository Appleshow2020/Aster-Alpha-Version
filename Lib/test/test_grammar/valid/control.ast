# 범위 for: 끝값은 포함하지 않고, 간격은 생략하면 1이다 [Q6]
for (int i; i = 1..6..2) {
    System.stdout.println(i);
}
for (int j; j = 0..10) { continue; }
#---
# 일반 for의 초기화는 대입이거나 값 없는 선언이어도 된다
int i;
for (i = 0; i < 3; i += 1) { break; }
for (int k; k < 3; k += 1) { }
