typedef struct P { int x; } P
#---
struct P { int x; }
#---
# 구조체 필드에는 초기값이 없다
struct P { int x = 3; };
#---
# 생성자 이름은 구조체 이름이어야 한다
typedef struct P { Q(int a) { } } P;
#---
struct P { P(int a): { } };
#---
# 지정 초기화와 위치 초기화는 섞어 쓰지 않는다
Point p = {.x = 1, 2};
#---
Point p = {1, .y = 2};
#---
Point p = {1, 2;
#---
struct P { void x; };
#---
# 태그 없는 구조체는 없다
typedef struct { int x; } P;