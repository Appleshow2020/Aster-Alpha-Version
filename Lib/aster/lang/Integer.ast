/* aster.lang.Integer: 32-bit integer wrapper with Java-style helpers.
   Aster's int is 64-bit, so the 32-bit Java semantics are emulated for
   MIN/MAX and for toHexString-style unsigned output. */

import aster.lang.Object;
import aster.lang.Number;

const str _INT_DIGITS = "0123456789abcdefghijklmnopqrstuvwxyz";

fn _intDigitValue(str ch) -> int {
    int d = _INT_DIGITS.find(ch.lower());
    return d;
}

/* 32-bit two's complement value as a non-negative Aster int. */
fn _intUnsigned(int value) -> int {
    if (value < 0) {
        return value + 4294967296;
    }
    return value;
}

fn _intUnsignedString(int value, int radix) -> str {
    int u = _intUnsigned(value);
    if (u == 0) {
        return "0";
    }
    str out = "";
    while (u > 0) {
        out = _INT_DIGITS.charAt(u % radix) + out;
        u = u / radix;
    }
    return out;
}

export class Integer extends Number {
    private int ival;

    public static int MAX_VALUE = 2147483647;
    public static int MIN_VALUE = -2147483647 - 1;
    public static int SIZE = 32;
    public static int BYTES = 4;

    constructor(int v) {
        super(v);
        self->ival = v;
    }

    public static fn parseInt(str s) -> int {
        return Integer.parseInt(s, 10);
    }

    public static fn parseInt(str s, int radix) -> int {
        if (radix < 2 or radix > 36) {
            throw "radix out of range: " + str(radix) as ValueError;
        }
        if (s.length() == 0) {
            throw "empty numeric string" as ValueError;
        }
        int pos = 0;
        int sign = 1;
        str first = s.charAt(0);
        if (first == "-") {
            sign = -1;
            pos = 1;
        }
        else if (first == "+") {
            pos = 1;
        }
        if (pos >= s.length()) {
            throw "invalid integer: " + s as ValueError;
        }
        int maxMagnitude = 2147483647;
        if (sign < 0) {
            maxMagnitude = 2147483648;
        }
        int value = 0;
        while (pos < s.length()) {
            int d = _intDigitValue(s.charAt(pos));
            if (d < 0 or d >= radix) {
                throw "invalid integer: " + s as ValueError;
            }
            if (value > maxMagnitude / radix) {
                throw "integer out of range: " + s as ValueError;
            }
            value = value * radix + d;
            if (value > maxMagnitude) {
                throw "integer out of range: " + s as ValueError;
            }
            pos = pos + 1;
        }
        return sign * value;
    }

    public static fn valueOf(int v) -> Integer {
        return new Integer(v);
    }

    public static fn toString(int value) -> str {
        return str(value);
    }

    public static fn toString(int value, int radix) -> str {
        if (radix < 2 or radix > 36) {
            throw "radix out of range: " + str(radix) as ValueError;
        }
        return _intUnsignedString(value, radix);
    }

    public static fn toHexString(int value) -> str {
        return _intUnsignedString(value, 16);
    }

    public static fn toOctalString(int value) -> str {
        return _intUnsignedString(value, 8);
    }

    public static fn toBinaryString(int value) -> str {
        return _intUnsignedString(value, 2);
    }

    public static fn compare(int x, int y) -> int {
        if (x < y) { return -1; }
        if (x > y) { return 1; }
        return 0;
    }

    public static fn compareUnsigned(int x, int y) -> int {
        return Integer.compare(_intUnsigned(x), _intUnsigned(y));
    }

    public static fn signum(int value) -> int {
        if (value < 0) { return -1; }
        if (value > 0) { return 1; }
        return 0;
    }

    public static fn max(int x, int y) -> int {
        if (x >= y) { return x; }
        return y;
    }

    public static fn min(int x, int y) -> int {
        if (x <= y) { return x; }
        return y;
    }

    public static fn sum(int x, int y) -> int {
        return x + y;
    }

    public static fn bitCount(int value) -> int {
        int u = _intUnsigned(value);
        int count = 0;
        while (u > 0) {
            if (u % 2 != 0) {
                count = count + 1;
            }
            u = u / 2;
        }
        return count;
    }

    public static fn highestOneBit(int value) -> int {
        int u = _intUnsigned(value);
        int p = 0;
        int bit = 1;
        while (bit <= u and bit <= 2147483648) {
            p = bit;
            bit = bit * 2;
        }
        return p;
    }

    public static fn lowestOneBit(int value) -> int {
        int u = _intUnsigned(value);
        if (u == 0) {
            return 0;
        }
        int p = 1;
        while (u % 2 == 0) {
            u = u / 2;
            p = p * 2;
        }
        return p;
    }

    public fn equals(Object? o) -> bool {
        if (not o) {
            return false;
        }
        if (typeName(o) != "Integer") {
            return false;
        }
        Integer other = (Integer) o;
        return self->ival == other->ival;
    }

    public fn hashCode() -> int {
        return self->ival;
    }

    public fn __eq__(Integer other) -> bool {
        return self->ival == other->ival;
    }

    public fn compareTo(Integer other) -> int {
        return Integer.compare(self->ival, other->ival);
    }

    public fn toString() -> str {
        return str(self->ival);
    }

    public fn __str__() -> str {
        return str(self->ival);
    }
}
