/* aster.util.Collection: Java Collection 계약.

   Aster의 interface는 제네릭 매개변수와 상속을 지원하지 않으므로 원소 타입은
   any로 두고, 하위 계약(List/Set)은 이 메서드들을 다시 선언한다. */

export interface Collection {
    fn size() -> int;
    fn isEmpty() -> bool;
    fn contains(any value) -> bool;
    fn add(any value) -> bool;
    fn remove(any value) -> bool;
    fn clear() -> void;
    fn iterator() -> any;
    fn toArray() -> list<any>;
}
