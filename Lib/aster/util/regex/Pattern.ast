/* aster.util.regex.Pattern: Java Pattern 스타일 정규식 API.
   패턴 문법과 매칭 semantics는 파이썬 re와 동일하다. 실제 엔진은
   aster.util.regex.Native에 있고, 이 클래스는 Java식 객체 API를 씌운다.

   사용 예:
       import aster.util.regex.Pattern;
       Pattern* p = Pattern.compile("(\\w+)@(\\w+)", Pattern.CASE_INSENSITIVE);
       Matcher* m = p->matcher("Mail: Foo@Example");
       while (m->find()) { println(m->group(1)); } */

import aster.util.regex.Native;
import aster.util.regex.Support;
import aster.util.regex.Matcher;

export class Pattern {
    public static int CASE_INSENSITIVE = 2;
    public static int IGNORECASE = 2;
    public static int MULTILINE = 8;
    public static int DOTALL = 16;
    public static int UNICODE = 32;
    public static int VERBOSE = 64;
    public static int ASCII = 256;

    private int pid;
    private str source;
    private int patFlags;

    constructor(str regex, int flags) {
        self->pid = Native.compile(regex, flags);
        self->source = regex;
        self->patFlags = Native.flags(self->pid);
    }

    public static fn compile(str regex) -> Pattern {
        return new Pattern(regex, 0);
    }

    public static fn compile(str regex, int flags) -> Pattern {
        return new Pattern(regex, flags);
    }

    /* 메타문자를 이스케이프한 리터럴 패턴을 돌려준다 (Java Pattern.quote와 유사). */
    public static fn quote(str text) -> str {
        return Native.escape(text);
    }

    public fn matcher(str input) -> Matcher {
        return new Matcher(self->pid, input, self->source, self->patFlags);
    }

    public fn pattern() -> str {
        return self->source;
    }

    public fn flags() -> int {
        return self->patFlags;
    }

    public fn groupCount() -> int {
        return Native.groupcount(self->pid);
    }

    /* 이름 있는 그룹 -> 번호 사전 (Python groupindex). */
    public fn groupIndex() -> dict<str, int> {
        return Native.groupindex(self->pid);
    }

    /* 입력 전체가 일치하는지 (Python fullmatch). */
    public fn matches(str input) -> bool {
        int mid = Native.exec(self->pid, input, 0, 2);
        return mid >= 0;
    }

    public fn split(str input) -> list<any> {
        return Native.split(self->pid, input, 0);
    }

    /* Java split(limit): limit > 0이면 최대 limit-1번 분리한다.
       Python re.split처럼 캡처 그룹도 결과에 섞인다. */
    public fn split(str input, int limit) -> list<any> {
        if (limit > 0) {
            return Native.split(self->pid, input, limit - 1);
        }
        return Native.split(self->pid, input, 0);
    }

    /* Python re.findall: 그룹이 없으면 str 리스트, 있으면 튜플 리스트. */
    public fn findAll(str input) -> list<any> {
        return Native.findall(self->pid, input);
    }

    public fn replaceAll(str input, str replacement) -> str {
        return Native.sub(self->pid, input, Support.javaReplacement(replacement), 0);
    }

    public fn replaceFirst(str input, str replacement) -> str {
        return Native.sub(self->pid, input, Support.javaReplacement(replacement), 1);
    }

    /* 내부 엔진의 패턴 id. Native.* 호출에 직접 넘길 수 있다. */
    public fn id() -> int {
        return self->pid;
    }

    public fn release() -> void {
        if (self->pid >= 0) {
            Native.release(self->pid);
            self->pid = -1;
        }
    }
}
