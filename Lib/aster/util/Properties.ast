/* aster.util.Properties: 문자열 키/값 속성 모음 (Java Properties 스타일).

   load(path)/store(path, comment)는 `key=value` 텍스트 파일을 읽고 쓴다.
   `#`으로 시작하는 줄과 빈 줄은 무시한다. list()는 표준 출력으로 나열한다. */

import System.stdout.*;
import aster.util.HashSet;

export class Properties {
    private dict<str, str> props;

    constructor() {
        self->props = {};
    }

    public fn setProperty(str key, str value) -> str? {
        str? old = null;
        if (key in self->props) {
            old = self->props[key];
        }
        self->props[key] = value;
        return old;
    }

    public fn getProperty(str key) -> str? {
        if (not (key in self->props)) {
            return null;
        }
        return self->props[key];
    }

    public fn getProperty(str key, str fallback) -> str {
        if (key in self->props) {
            return self->props[key];
        }
        return fallback;
    }

    public fn containsKey(str key) -> bool {
        return key in self->props;
    }

    public fn size() -> int {
        return len(self->props);
    }

    public fn isEmpty() -> bool {
        return len(self->props) == 0;
    }

    public fn remove(str key) -> str? {
        if (not (key in self->props)) {
            return null;
        }
        return self->props.pop(key);
    }

    public fn clear() -> void {
        self->props.clear();
    }

    /* 키 집합(삽입 순서 유지). 자바와 같이 Set을 돌려준다. */
    public fn stringPropertyNames() -> HashSet<str> {
        HashSet<str> names = new HashSet<str>();
        for (str key in self->props.keys()) {
            names.add(key);
        }
        return names;
    }

    /* 키 리스트. */
    public fn propertyNames() -> list<str> {
        return self->props.keys();
    }

    public fn load(str path) -> void {
        str text = Files.readString(path);
        list<str> lines = text.split("\n");
        int i = 0;
        while (i < len(lines)) {
            str line = lines[i].trim();
            i = i + 1;
            if (line.length() == 0) {
                continue;
            }
            if (line.charAt(0) == "#") {
                continue;
            }
            int eq = line.find("=");
            int colon = line.find(":");
            int cut = -1;
            if (eq >= 0 and (colon < 0 or eq < colon)) {
                cut = eq;
            }
            else if (colon >= 0) {
                cut = colon;
            }
            if (cut < 0) {
                self->props[line] = "";
            }
            else {
                str key = line.substring(0, cut).trim();
                str value = line.substring(cut + 1).trim();
                self->props[key] = value;
            }
        }
    }

    public fn store(str path, str comment) -> void {
        list<str> lines = [];
        if (comment.length() > 0) {
            lines.append("#" + comment);
        }
        for (str key in self->props.keys()) {
            lines.append(key + "=" + self->props[key]);
        }
        str text = "\n".join(lines);
        if (len(lines) > 0) {
            text = text + "\n";
        }
        Files.writeString(path, text);
    }

    /* 표준 출력에 key=value를 한 줄씩 쓴다. */
    public fn list() -> void {
        for (str key in self->props.keys()) {
            println(key + "=" + self->props[key]);
        }
    }

    public fn toMap() -> dict<str, str> {
        return self->props.copy();
    }

    public fn __len__() -> int {
        return len(self->props);
    }

    public fn __str__() -> str {
        return str(self->props);
    }
}
