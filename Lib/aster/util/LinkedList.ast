/* aster.util.LinkedList: Java LinkedList 스타일 리스트 + 덱 + 큐.

   내부는 list<E> 하나다(양 끝 연산은 리스트 연산으로 위임).
   List와 Queue 계약을 모두 구현한다. */

import aster.util.List;
import aster.util.Queue;
import aster.util.ListIterator;
import aster.util.ListIteratorImpl;
import aster.util.Comparator;

export class LinkedList<E> implements List, Queue {
    private list<E> items;
    private int cursor;

    constructor() {
        self->items = [];
        self->cursor = 0;
    }

    public fn size() -> int {
        return len(self->items);
    }

    public fn isEmpty() -> bool {
        return len(self->items) == 0;
    }

    public fn add(E value) -> bool {
        self->items.append(value);
        return true;
    }

    public fn add(int index, E value) -> void {
        if (index < 0 or index > len(self->items)) {
            throw "index out of range: " + str(index) as IndexError;
        }
        self->items.insert(index, value);
    }

    public fn get(int index) -> E {
        if (index < 0 or index >= len(self->items)) {
            throw "index out of range: " + str(index) as IndexError;
        }
        return self->items[index];
    }

    public fn set(int index, E value) -> E {
        if (index < 0 or index >= len(self->items)) {
            throw "index out of range: " + str(index) as IndexError;
        }
        E old = self->items[index];
        self->items[index] = value;
        return old;
    }

    /* 값 제거. 런타임 오버로드 선택이 타입 매개변수(E)를 구분하지 못하므로
       remove(any)를 먼저 선언해 값 제거의 대표 구현으로 둔다. int 값은
       아래 remove(int index)가 정확히 매칭되어 인덱스 제거로 간다.
       따라서 `remove(any)` 안에서 int가 들어오면 인덱스로 해석한다. */
    public fn remove(any value) -> bool {
        if (typeName(value) == "int") {
            int index = (int)value;
            if (index < 0 or index >= len(self->items)) {
                return false;
            }
            self->items.pop(index);
            return true;
        }
        if (not (value in self->items)) {
            return false;
        }
        self->items.remove(value);
        return true;
    }

    public fn remove(int index) -> E {
        if (index < 0 or index >= len(self->items)) {
            throw "index out of range: " + str(index) as IndexError;
        }
        return self->items.pop(index);
    }

    public fn contains(E value) -> bool {
        return value in self->items;
    }

    public fn indexOf(E value) -> int {
        int i = 0;
        while (i < len(self->items)) {
            if (self->items[i] == value) {
                return i;
            }
            i = i + 1;
        }
        return -1;
    }

    public fn lastIndexOf(E value) -> int {
        int i = len(self->items) - 1;
        while (i >= 0) {
            if (self->items[i] == value) {
                return i;
            }
            i = i - 1;
        }
        return -1;
    }

    public fn clear() -> void {
        self->items.clear();
        self->cursor = 0;
    }

    public fn addAll(list<E> values) -> bool {
        int i = 0;
        while (i < len(values)) {
            self->items.append(values[i]);
            i = i + 1;
        }
        return len(values) > 0;
    }

    public fn toArray() -> list<E> {
        return self->items.copy();
    }

    public fn iterator() -> ListIterator {
        return new ListIteratorImpl<E>(self->items);
    }

    public fn sort() -> void {
        self->items.sort();
    }

    public fn sort(Comparator* cmp) -> void {
        int i = 1;
        while (i < len(self->items)) {
            E key = self->items[i];
            int j = i - 1;
            while (j >= 0 and cmp.compare(self->items[j], key) > 0) {
                self->items[j + 1] = self->items[j];
                j = j - 1;
            }
            self->items[j + 1] = key;
            i = i + 1;
        }
    }

    /* --- 덱 연산 --- */

    public fn addFirst(E value) -> void {
        self->items.insert(0, value);
    }

    public fn addLast(E value) -> void {
        self->items.append(value);
    }

    public fn getFirst() -> E {
        if (len(self->items) == 0) {
            throw "list is empty" as NoSuchElementError;
        }
        return self->items[0];
    }

    public fn getLast() -> E {
        if (len(self->items) == 0) {
            throw "list is empty" as NoSuchElementError;
        }
        return self->items[len(self->items) - 1];
    }

    public fn removeFirst() -> E {
        if (len(self->items) == 0) {
            throw "list is empty" as NoSuchElementError;
        }
        return self->items.pop(0);
    }

    public fn removeLast() -> E {
        if (len(self->items) == 0) {
            throw "list is empty" as NoSuchElementError;
        }
        return self->items.pop();
    }

    public fn peek() -> E? {
        if (len(self->items) == 0) {
            return null;
        }
        return self->items[0];
    }

    public fn peekFirst() -> E? {
        return self->peek();
    }

    public fn peekLast() -> E? {
        if (len(self->items) == 0) {
            return null;
        }
        return self->items[len(self->items) - 1];
    }

    public fn poll() -> E? {
        if (len(self->items) == 0) {
            return null;
        }
        return self->items.pop(0);
    }

    public fn pollFirst() -> E? {
        return self->poll();
    }

    public fn pollLast() -> E? {
        if (len(self->items) == 0) {
            return null;
        }
        return self->items.pop();
    }

    public fn offer(E value) -> bool {
        self->items.append(value);
        return true;
    }

    public fn offerFirst(E value) -> bool {
        self->items.insert(0, value);
        return true;
    }

    public fn offerLast(E value) -> bool {
        self->items.append(value);
        return true;
    }

    public fn push(E value) -> void {
        self->items.insert(0, value);
    }

    public fn pop() -> E {
        return self->removeFirst();
    }

    public fn __iter__() -> LinkedList<E> {
        self->cursor = 0;
        return self;
    }

    public fn __next__() -> E {
        if (self->cursor >= len(self->items)) {
            throw "done" as StopIteration;
        }
        E value = self->items[self->cursor];
        self->cursor = self->cursor + 1;
        return value;
    }

    public fn __len__() -> int {
        return len(self->items);
    }

    public fn __str__() -> str {
        return str(self->items);
    }

    public fn toString() -> str {
        return str(self->items);
    }
}
