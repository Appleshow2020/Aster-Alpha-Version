/* aster.util.StringTokenizer: 구분자 기준 토큰 분리기 (Java 스타일).

   생성자 오버로드가 없으므로 기본 구분자(" \t\n\r\f") 생성자는
   `new StringTokenizer(text)`, 사용자 구분자는
   `StringTokenizer.withDelimiters(text, delims)` 정적 팩토리를 쓴다.
   토큰은 생성 시 한 번 계산해 둔다. */

const str DEFAULT_DELIMS = " \t\n\r\f";

export class StringTokenizer {
    private list<str> tokens;
    private int position;

    constructor(str text) {
        self->tokens = StringTokenizer.split(text, DEFAULT_DELIMS);
        self->position = 0;
    }

    public static fn withDelimiters(str text, str delims) -> StringTokenizer {
        StringTokenizer st = new StringTokenizer(text);
        st.tokens = StringTokenizer.split(text, delims);
        st.position = 0;
        return st;
    }

    private static fn split(str text, str delims) -> list<str> {
        list<str> out = [];
        list<str> current = [];
        int i = 0;
        while (i < text.length()) {
            str ch = text.charAt(i);
            if (delims.find(ch) >= 0) {
                if (len(current) > 0) {
                    out.append("".join(current));
                    current = [];
                }
            }
            else {
                current.append(ch);
            }
            i = i + 1;
        }
        if (len(current) > 0) {
            out.append("".join(current));
        }
        return out;
    }

    public fn hasMoreTokens() -> bool {
        return self->position < len(self->tokens);
    }

    public fn nextToken() -> str {
        if (not self->hasMoreTokens()) {
            throw "no more tokens" as NoSuchElementError;
        }
        str token = self->tokens[self->position];
        self->position = self->position + 1;
        return token;
    }

    public fn countTokens() -> int {
        return len(self->tokens) - self->position;
    }

    public fn __len__() -> int {
        return self->countTokens();
    }
}
