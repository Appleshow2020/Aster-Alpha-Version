-- Aster AST 정의.
-- (Tools/check_conformance.py가 두 파일이 어긋나면 오류를 낸다.)
--
-- 자료구조 자체가 문법 규칙을 담도록 설계했다.
--   * void는 ret에만 있고 typeref에는 없다 (변수/필드 타입으로 void 불가).
--   * prim에 void가 없고, 함수 타입(FuncType)은 소스에 쓸 수 없으므로 AST에도 없다.
--   * 구조체는 ClassDef와 별개의 StructDef다 (클래스로 합치지 않는다).
--   * Constant의 값은 파이썬 값이지만 bool은 int의 하위 타입(True == 1)이므로
--     컴파일러/VM에서는 type(value)로 구분해서 Aster 타입(int/bool)으로 감싼다.

module Aster
{
     mod = Module(identifier* package, stmt* body)
 
     stmt = FunctionDef(identifier name, type_param* type_params, param* params,
                        ret returns, stmt* body, int is_extern)
          | ClassDef(identifier name, type_param* type_params, typeref? base,
                     typeref* interfaces, member* members)
          | InterfaceDef(identifier name, type_param* type_params,
                        signature* methods)
          -- alias가 있으면 typedef struct, 없으면 plain struct
          | StructDef(identifier tag, identifier? alias, struct_member* members)
          | VarDecl(typeref ty, identifier name, initializer init, int is_const)
          -- enum Color { RED, GREEN, BLUE }  (값은 선언 순서 ordinal)
          -- enum Shape { Circle(float r), Rect(float w, float h), Empty }
          -- members 뒤 ';' 다음에 메서드를 둘 수 있다.
          | EnumDef(identifier name, enum_member* members, member* methods)
          -- 'var (a, b) = expr;' 또는 '(a, b) = expr;'
          | Destructure(identifier* names, expr value)
          | Assert(expr test, expr? message)
          | Assign(expr target, assign_op op, expr value)
          -- orelse가 빈 리스트면 else 없음. else if는 orelse = [If(...)]
          | If(expr test, stmt* body, stmt* orelse)
          | While(expr test, stmt* body)
          -- init: VarDecl 또는 Assign, step: Assign
          | For(stmt init, expr test, stmt step, stmt* body)
          | ForRange(typeref ty, identifier name, range_expr iter, stmt* body)
          -- for (T x in expr) { ... }. iterable은 list/tuple/set/frozenset/dict/str.
          | ForIn(typeref ty, identifier name, expr iter, stmt* body)
          -- switch (subject) { case PATTERN { ... } ... default { ... } }
          | Switch(expr subject, match_case* cases)
          | Try(stmt* body, handler* handlers, stmt* finalbody)
          -- yield expr;  (제너레이터 함수 안에서만)
          | Yield(expr? value)
          | Return(expr? value)
          -- exc_type가 None이면: value가 str이면 Exception, 예외 값이면 그 예외.
          -- exc_type가 있으면 value는 str이어야 한다 (typecheck).
          | Throw(expr value, identifier? exc_type)
          | Break
          | Continue
          -- wildcard가 1이면 'import a.b.*;' 이다. (ASDL에는 bool이 없으므로 int를 쓴다.)
          -- alias가 있으면 'import a.b as c;' 이다.
          | Import(identifier* path, int wildcard, identifier? alias)
          -- names가 비어 있으면 'from m import *;' 이다.
          -- 'from m import A, B as C;' 처럼 여러 이름을 한 번에 가져올 수 있다.
          | ImportFrom(identifier* module, import_name* names)
          -- 'export <선언>' — 모듈에서 공개할 선언을 표시한다.
          | Export(stmt body)
          -- 'exception 이름 [extends 부모];'
          | ExceptionDef(identifier name, identifier? base)
          | ExprStmt(expr value)
          attributes (int lineno, int col_offset, int end_lineno, int end_col_offset)

    -- params가 빈 리스트면 '() => ...' 형태이다.
     expr = Lambda(lparam* params, ret returns, expr body)
          | Pipe(expr value, expr func)
          -- test ? body : orelse (C 스타일 삼항 연산자)
          | Ternary(expr test, expr body, expr orelse)
          | Coalesce(expr left, expr right)
          | BoolOp(boolop op, expr left, expr right)
          | UnaryOp(unaryop op, expr operand)
          | BinOp(expr left, operator op, expr right)
          | Compare(expr left, cmpop op, expr right)
          | Is(expr value, typeref ty)
          | In(expr item, expr container)
          | Cast(typeref ty, expr value)
          | AddressOf(expr value)
          | Deref(expr value)
          | SizeOf(typeref ty)
          | Call(expr func, expr* args, keyword* keywords)
          -- 결과는 주소(Cls*)이다.
          | New(identifier cls, typeref* type_args, expr* args)
          | Attribute(expr value, identifier attr)
          -- p->x
          | PtrAttribute(expr value, identifier attr)
          -- base?.name (base가 null이면 결과도 null)
          | OptionalAttribute(expr value, identifier attr)
          | Name(identifier id)
          | Self
          -- int, float, str, bool, None(null)
          | Constant(constant value)
          | Array(expr* elements)
          -- 포함 범위: 1..5 는 [1, 2, 3, 4, 5] 를 만든다. step은 1..5..2 처럼 쓴다.
          | Range(expr start, expr stop, expr? step)
          | Subscript(expr value, expr index)
          | Slice(expr? lower, expr? upper, expr? step)
          | FString(expr* values)
          | FormattedValue(expr value, int conversion, expr? format_spec)
          -- 컬렉션 리터럴. 파이썬과 같은 값을 만든다.
          -- []는 빈 리스트, ()는 빈 튜플, {}는 빈 딕셔너리, {1, 2}는 세트다.
          -- 빈 세트는 set() 내장으로 만든다 (파이썬과 같다).
          -- frozenset은 리터럴이 없고 frozenset(...) 내장으로 만든다.
          | List(expr* elements)
          | Tuple(expr* elements)
          | Dict(expr* keys, expr* values)
          | Set(expr* elements)
          -- '*expr' 컬렉션 펼치기 (리스트/세트/튜플, 딕셔너리에서는 '**expr')
          | Spread(expr value)
          -- 컴프리헨션: [elt for x in iter if cond]
          | ListComp(expr elt, identifier name, expr iter, expr? cond)
          | SetComp(expr elt, identifier name, expr iter, expr? cond)
          | DictComp(expr key, expr value, identifier name, expr iter, expr? cond)
          -- x++ / ++x / x-- / --x. is_inc=1이면 증가, 0이면 감소.
          | Incr(expr target, int is_inc, int is_prefix)
          attributes (int lineno, int col_offset, int end_lineno, int end_col_offset)

     typeref = Primitive(prim kind)
             -- args가 빈 리스트이면 제네릭이 아닌 타입
             | Named(identifier name, typeref* args)
             | StructRef(identifier tag)
             | Pointer(typeref base)
             | Nullable(typeref base)
             -- 합집합 타입: int | str | null
             | UnionTy(typeref* members)
             -- 함수 타입: fn(int, str) -> bool
             | FunctionTy(typeref* params, ret returns)
 
     prim = IntT | FloatT | BoolT | StrT | NullT
 
     ret = VoidRet | ValueRet(typeref ty)
 
     -- 제네릭 타입 매개변수. bound는 'T extends Number'의 Number이다.
     type_param = (identifier name, typeref? bound)
 
     -- 매개변수. default는 기본 인자, variadic은 0=일반 1=vararg 2=varkwarg.
     param = (typeref ty, identifier name, expr? default_value, int variadic)
     -- 호출의 이름 있는 인자: f(name = 값)
     keyword = (identifier name, expr value)
     -- 'from m import A as B;'의 한 항목
     import_name = (identifier name, identifier? alias)
     -- 람다의 단일 매개변수는 타입을 생략할 수 있다.
     lparam = (typeref? ty, identifier name)
     signature = (access? access, identifier name, param* params, ret returns)
     handler = (typeref ty, identifier name, stmt* body)
     range_expr = (expr start, expr stop, expr? step)
     enum_member = (identifier name, param* params, expr? value)
 
     -- switch의 case 하나. pattern이 맞으면 guard를 검사하고 body를 실행한다.
     -- guard가 없거나(None) guard가 참이면 그 case가 선택된다 (fallthrough 없음).
     match_case = (match_pattern pattern, expr? guard, stmt* body)
     -- PLiteral: 1, "x", true, null 같은 리터럴 상수
     -- PVariant: Shape.Circle(r) 처럼 타입.변형(하위 패턴...) 형태
     -- PBind: 이름 하나로 아무 값이나 받는다 (_는 바인딩하지 않는 와일드카드)
     -- PList: [a, b] 처럼 리스트를 분해한다. rest가 있으면 [a, *rest] 형태.
     -- PDict: {"k": v} 처럼 딕셔너리를 분해한다. rest가 있으면 {**rest} 형태.
     match_pattern = PLiteral(expr value)
                   | PVariant(expr path, match_pattern* items)
                   | PBind(identifier name)
                   | PList(match_pattern* items, identifier? rest)
                   | PDict(pdict_item* items, identifier? rest)
     -- 딕셔너리 패턴의 한 항목. key는 문자열/정수 같은 리터럴 식이다.
     pdict_item = (expr key, match_pattern value)
 
     initializer = NoInit
                 | ExprInit(expr value)
                 | PositionalInit(expr* values)
                 | DesignatedInit(designation* items)
     designation = (identifier field, expr value)
 
     access = Public | Protected | Private | Internal
 
     -- access가 None이면 기본값(private)을 의미 분석에서 적용한다.
     member = Field(access? access, typeref ty, identifier name, expr? value, int is_static)
            | Method(access? access, identifier name, type_param* type_params,
                     param* params, ret returns, stmt* body, int is_static)
            | Constructor(param* params, stmt* body)
            | Property(access? access, typeref ty, identifier name)
            | Getter(identifier name, stmt* body)
            | Setter(identifier name, param param, stmt* body)
            attributes (int lineno, int col_offset, int end_lineno, int end_col_offset)
 
     -- inits가 빈 리스트면 초기화 리스트를 쓰지 않은 생성자이다.
     struct_member = StructField(typeref ty, identifier name)
                   | StructCtor(param* params, member_init* inits, stmt* body)
     member_init = (identifier field, expr value)
 
     boolop = And | Or
     unaryop = UAdd | USub | Not
     operator = Add | Sub | Mult | Div | FloorDiv | Mod | Pow
     cmpop = Eq | NotEq | Lt | LtE | Gt | GtE
     assign_op = AssignEq | AssignAdd | AssignSub | AssignMult | AssignDiv
               | AssignFloorDiv | AssignMod | AssignPow
}